# Copie para .env e ajuste (o .env não vai para o Git)
DATABASE_URL=postgresql://postgres:senha@localhost:5432/nutris
# Use true apenas ao conectar no Postgres por URL pública (fora da rede interna do Railway)
DATABASE_SSL=false

# Administrador criado automaticamente na primeira inicialização
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@suaclinica.com.br
ADMIN_PASSWORD=troque-esta-senha
# Defina true por um deploy para redefinir a senha do admin a partir de ADMIN_PASSWORD
ADMIN_REDEFINIR_SENHA=false

PORT=3000
